<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <%- include('partials/head') %>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 min-h-screen flex flex-col justify-center items-center p-4">

    <div class="w-full max-w-md bg-white rounded-3xl shadow-xl border border-slate-100 p-8">
        <div class="flex items-center gap-3 mb-6">
            <a href="/wallet" class="material-symbols-outlined text-slate-500">arrow_back</a>
            <h1 class="text-xl font-bold text-[#00317e]">Novo Cartão de Transporte</h1>
        </div>

        <% if (erro) { %>
            <div class="mb-4 bg-red-50 text-red-600 text-xs p-3 rounded-xl"><%= erro %></div>
        <% } %>

        <form action="/cartoes/novo" method="POST" class="space-y-5">
            <div>
                <label class="block text-xs font-bold text-slate-400 uppercase mb-2">Número do Cartão</label>
                <input type="text" name="numeroCartao" required placeholder="Ex: 10203040" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-[#0046ad]" />
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-400 uppercase mb-2">Tipo do Cartão</label>
                <div class="grid grid-cols-2 gap-3">
                    <label class="flex items-center gap-2 border p-3 rounded-xl cursor-pointer hover:border-red-500">
                        <input type="radio" name="tipo" value="Comum" required />
                        <span class="w-3 h-3 rounded-full bg-red-500"></span>
                        <span class="text-xs font-bold">Comum</span>
                    </label>
                    <label class="flex items-center gap-2 border p-3 rounded-xl cursor-pointer hover:border-green-500">
                        <input type="radio" name="tipo" value="Vale-Transporte" />
                        <span class="w-3 h-3 rounded-full bg-green-500"></span>
                        <span class="text-xs font-bold">VT</span>
                    </label>
                    <label class="flex items-center gap-2 border p-3 rounded-xl cursor-pointer hover:border-blue-500">
                        <input type="radio" name="tipo" value="Escolar" />
                        <span class="w-3 h-3 rounded-full bg-blue-500"></span>
                        <span class="text-xs font-bold">Escolar</span>
                    </label>
                    <label class="flex items-center gap-2 border p-3 rounded-xl cursor-pointer hover:border-slate-500">
                        <input type="radio" name="tipo" value="Universitário" />
                        <span class="w-3 h-3 rounded-full bg-slate-500"></span>
                        <span class="text-xs font-bold">Universitário</span>
                    </label>
                </div>
            </div>

            <button type="submit" class="w-full bg-[#0046ad] text-white py-4 rounded-xl font-bold text-sm shadow-md hover:bg-[#00317e] transition-all">
                Cadastrar Cartão
            </button>
        </form>
    </div>

</body>
</html>


