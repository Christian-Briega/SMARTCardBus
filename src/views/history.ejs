<!DOCTYPE html>
<html lang="pt-br">
<head>
    <%- include('partials/head') %>
</head>
<body class="bg-background text-slate-900 flex flex-col min-h-screen">

    <header class="bg-white px-4 h-16 flex items-center gap-4 sticky top-0 z-50 border-b border-slate-100">
        <button class="material-symbols-outlined text-slate-500">arrow_back</button>
        <h1 class="text-lg font-bold">Histórico de Uso</h1>
    </header>

    <main class="flex-grow pt-20 pb-24 px-4 max-w-lg mx-auto w-full">
        
        <div class="flex gap-2 overflow-x-auto pb-4 no-scrollbar">
            <button class="bg-primary text-white px-4 py-2 rounded-full text-xs font-bold whitespace-nowrap">Este Mês</button>
            <button class="bg-white border border-slate-200 px-4 py-2 rounded-full text-xs font-bold whitespace-nowrap">Recargas</button>
            <button class="bg-white border border-slate-200 px-4 py-2 rounded-full text-xs font-bold whitespace-nowrap">Viagens</button>
        </div>

        <div class="space-y-6">
            <div>
                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-3">Hoje, 08 de Maio</p>
                <div class="bg-white rounded-2xl border border-slate-100 divide-y divide-slate-50">
                    <div class="p-4 flex justify-between items-center">
                        <div class="flex gap-3">
                            <div class="w-10 h-10 bg-blue-50 text-primary rounded-xl flex items-center justify-center">
                                <span class="material-symbols-outlined">directions_bus</span>
                            </div>
                            <div>
                                <p class="text-sm font-bold">Linha 3.33</p>
                                <p class="text-[11px] text-slate-400">08:45 • Validador 4829</p>
                            </div>
                        </div>
                        <p class="font-bold text-error">-1</p>
                    </div>
                    <div class="p-4 flex justify-between items-center">
                        <div class="flex gap-3">
                            <div class="w-10 h-10 bg-green-50 text-green-600 rounded-xl flex items-center justify-center">
                                <span class="material-symbols-outlined">payments</span>
                            </div>
                            <div>
                                <p class="text-sm font-bold">Recarga PIX</p>
                                <p class="text-[11px] text-slate-400">07:20 • App Transurc</p>
                            </div>
                        </div>
                        <p class="font-bold text-green-600">+20</p>
                    </div>
                </div>
            </div>

            <div>
                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-3">Ontem, 07 de Maio</p>
                <div class="bg-white rounded-2xl border border-slate-100 divide-y divide-slate-50">
                    <div class="p-4 flex justify-between items-center">
                        <div class="flex gap-3">
                            <div class="w-10 h-10 bg-blue-50 text-primary rounded-xl flex items-center justify-center">
                                <span class="material-symbols-outlined">directions_bus</span>
                            </div>
                            <div>
                                <p class="text-sm font-bold">Linha 1.21</p>
                                <p class="text-[11px] text-slate-400">18:10 • Terminal Central</p>
                            </div>
                        </div>
                        <p class="font-bold text-error">-1</p>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <%- include('partials/navbar') %>

</body>
</html>